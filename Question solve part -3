/* 1. DOCUMENTATION SECTION
   Description: This program calculates the area of a circle.
*/

#include <stdio.h>   // 2. LINK SECTION (Header files)
#define PI 3.1415    // 3. DEFINITION SECTION (Macro/Constants)

int global_var = 10; // 4. GLOBAL DECLARATION SECTION

// 5. MAIN FUNCTION SECTION (Execution starts here)
int main() {
    float radius, area; 

    printf("Enter radius: ");
    scanf("%f", &radius);

    area = PI * radius * radius;

    printf("Area is: %.2f", area);

    return 0; // End of main function
}

