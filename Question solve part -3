// biggest number -> 

#include <stdio.h>

int main() {
    int A, B, C;
    scanf("%d %d %d", &A, &B, &C);

    if (A >= B && A >= C)
        printf("%d is the biggest.", A);
    else if (B >= A && B >= C)
        printf("%d is the biggest.", B);
    else
        printf("%d is the biggest.", C);

    return 0;
}

