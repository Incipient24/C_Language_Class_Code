//while loop
#include <stdio.h>

int main() {
    int i, sum = 0;
    i = 0;
    while (i < 5) {
        sum += i;
        printf("%d %d\n", i, sum);
        i++;
    }
    return 0;
}
//do while loop
#include <stdio.h>

int main() {
    int i, sum = 0;
    i = 0;
    do {
        sum += i;
        printf("%d %d\n", i, sum);
        i++;
    } while (i < 5);
    return 0;
}

