//sallery increase
#include <stdio.h>

int main() {
    float salary;
    int years = 0;

    scanf("%f", &salary);

    while (salary < 2000) {
        salary = salary + (salary * 0.05);
        years++;
    }

    printf("%d\n", years);

    return 0;
}

//armstrong number 

#include <stdio.h>
#include <math.h>

int main() {
    int num, originalNum, remainder, n = 0;
    double result = 0.0;

    scanf("%d", &num);

    originalNum = num;
    int temp = num;
    while (temp != 0) {
        temp /= 10;
        n++;
    }

    temp = num;

    
    while (temp != 0) {
        remainder = temp % 10;
        result += pow(remainder, n);
        temp /= 10;
    }

    
    if ((int)result == originalNum)
        printf("Armstrong number\n");
    else
        printf("Not an Armstrong Number\n");

    return 0;
}
